PROJECT_NAME="Company Intelligence AI Service"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
INTERNAL_API_KEY=company_intel_internal_sec_token_2026_9f8e7d
ALLOWED_ORIGINS=["http://localhost:5000","http://localhost:5173"]
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
MONGODB_DB_NAME=company_intelligence
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Jira Live Integration (Optional - Falls back to Project Alpha dataset if omitted)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_atlassian_api_token
JIRA_PROJECT_KEY=ALPHA
# Notion Live Integration (Optional - Falls back to Project Alpha specs/notes dataset if omitted)
NOTION_API_KEY=secret_your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here
# Gmail Live Integration (Optional - Falls back to Project Alpha customer escalations dataset if omitted)
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token
